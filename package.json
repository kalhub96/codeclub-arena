{
  "name": "codeclub-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "import": "tsx src/scripts/import.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "grammy": "^1.30.0",
    "pino": "^9.0.0",
    "postgres": "^3.4.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
